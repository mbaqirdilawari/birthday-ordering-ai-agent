# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore, so your key is never uploaded to GitHub.

# Your Anthropic API key. Leave it empty to run the agent in free demo mode.
ANTHROPIC_API_KEY=

# Optional: which Claude model the agent uses (default: claude-sonnet-5-5).
AGENT_MODEL=claude-sonnet-5-5
